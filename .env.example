# OpenRouteService — コース自動生成ウィザードのルート取得
# https://openrouteservice.org/dev/#/signup
EXPO_PUBLIC_ORS_API_KEY=

# Google Maps — Android 実機の react-native-maps タイル表示（iOS は Apple Maps がデフォルト）
# Google Cloud Console → API とサービス → 認証情報 → Maps SDK for Android を有効化
# https://console.cloud.google.com/google/maps-apis
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — アプリ全体（Realtime / 走行データ保存など）
# Dashboard → Project Settings → API から取得
# https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=
# Dashboard → Settings → API Keys の Publishable key（sb_publishable_...）または legacy anon（eyJ...）
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 追走 Realtime ルーム利用時: Authentication → Anonymous Sign-Ins を ON 推奨
# モバイルアプリ（匿名認証）では CAPTCHA 保護は OFF 推奨:
# Dashboard → Authentication → Bot and Abuse Protection → Enable CAPTCHA protection
# Dashboard → Realtime が有効であることも確認
# 走行 JSON の Storage バケット（Dashboard → Storage で "logs" を作成）
# EXPO_PUBLIC_SUPABASE_TELEMETRY_BUCKET=logs

# LINE 公式アカウント Basic ID（@ なし）— 設定画面の「友だち追加」ボタン用
# LINE Developers → チャネル基本設定 → Basic ID
# EXPO_PUBLIC_LINE_OA_BASIC_ID=

# Supabase Edge Functions — LINE ID 暗号化（Dashboard から平文を見えにくくする）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 設定: supabase secrets set LINE_TARGET_ENCRYPTION_KEY=<上記>
# 既存データ移行: SUPABASE_SERVICE_ROLE_KEY=<service role> npm run migrate:line-encrypt
# SUPABASE_SERVICE_ROLE_KEY=  （migrate スクリプト用・リポジトリにコミットしない）
